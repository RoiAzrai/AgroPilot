# AgroPilot registry-service: live demo
# Open in VS Code with the "REST Client" extension (humao.rest-client).
# Click "Send Request" above each request; the response opens on the right.
#
# Before the demo, from services/registry-service:
#   bash seed_registry.sh                                   # fresh, known data
#   uv run uvicorn main:app --host 127.0.0.1 --port 8000    # start the service
# Run the requests top to bottom: some depend on the ones above them.

@base = http://127.0.0.1:8000
@demoCoop = b7e2c0a0-3c1d-4f0a-9a11-0c5d2e6f1001
@eastFarm = a9c1e4b2-6f70-4d8e-a144-3f8b5c904004
@northBlock = c8f3d1b0-4d2e-5a1b-8b22-1d6e3f702002


############################################################
# 0. Is it up?
############################################################

### ✓ 200 {"status": "ok"}
GET {{base}}/health


############################################################
# FR-1.1 · Farms CRUD
############################################################

### ✓ 200: the two seeded farms
GET {{base}}/v1/farms

### ✓ 201: new farm, id generated by the service (uuid4)
# @name newFarm
POST {{base}}/v1/farms
Content-Type: application/json

{ "name": "Demo farm" }

### ✓ 200: read it back by the generated id
GET {{base}}/v1/farms/{{newFarm.response.body.$.id}}

### ✓ 200: PATCH changes only the fields sent
PATCH {{base}}/v1/farms/{{newFarm.response.body.$.id}}
Content-Type: application/json

{ "name": "Demo farm (renamed)" }

### ✓ 204: delete a farm with no plots
DELETE {{base}}/v1/farms/{{newFarm.response.body.$.id}}

### ✗ 404 NOT_FOUND "Farm not found": it's gone
GET {{base}}/v1/farms/{{newFarm.response.body.$.id}}

### ✗ 404 NOT_FOUND: a path id that is not a UUID (judgment log #6)
GET {{base}}/v1/farms/abc

### ✗ 409 CONFLICT "Farm has plots; delete or move them first"
# Same FK error, different meaning: a valid request that clashes with state (#1)
DELETE {{base}}/v1/farms/{{demoCoop}}


############################################################
# FR-1.1 · Plots CRUD
############################################################

### ✓ 200: all four seeded plots
GET {{base}}/v1/plots

### ✓ 200: only one farm's plots
GET {{base}}/v1/plots?farm_id={{eastFarm}}

### ✓ 200 []: a filter that matches nothing is an empty list (#6)
GET {{base}}/v1/plots?farm_id=00000000-0000-4000-8000-000000000000

### ✓ 201: the exact body from the spec
# @name southBlock
POST {{base}}/v1/plots
Content-Type: application/json

{
  "farm_id": "b7e2c0a0-3c1d-4f0a-9a11-0c5d2e6f1001",
  "name": "South block",
  "area_m2": 1000,
  "crop_id": "tomato",
  "planting_date": "2026-03-01",
  "soil_id": "loam",
  "row_spacing_m": 1.5,
  "emitter_spacing_m": 0.4,
  "emitter_id": "dripnet-pc-1.0",
  "lat": 31.25,
  "lon": 34.79
}

### ✗ 409 CONFLICT: send the same plot again. UNIQUE(farm_id, name) catches it (#5)
POST {{base}}/v1/plots
Content-Type: application/json

{
  "farm_id": "b7e2c0a0-3c1d-4f0a-9a11-0c5d2e6f1001",
  "name": "South block",
  "area_m2": 1000,
  "crop_id": "tomato",
  "planting_date": "2026-03-01",
  "soil_id": "loam",
  "row_spacing_m": 1.5,
  "emitter_spacing_m": 0.4,
  "emitter_id": "dripnet-pc-1.0",
  "lat": 31.25,
  "lon": 34.79
}

### ✓ 201: the same name in ANOTHER farm is allowed
POST {{base}}/v1/plots
Content-Type: application/json

{
  "farm_id": "a9c1e4b2-6f70-4d8e-a144-3f8b5c904004",
  "name": "South block",
  "area_m2": 1000,
  "crop_id": "tomato",
  "planting_date": "2026-03-01",
  "soil_id": "loam",
  "row_spacing_m": 1.5,
  "emitter_spacing_m": 0.4,
  "emitter_id": "dripnet-pc-1.0",
  "lat": 31.25,
  "lon": 34.79
}

### ✗ 422 VALIDATION "Unknown emitter": check_references names the field (#2)
POST {{base}}/v1/plots
Content-Type: application/json

{
  "farm_id": "b7e2c0a0-3c1d-4f0a-9a11-0c5d2e6f1001",
  "name": "West field",
  "area_m2": 1000,
  "crop_id": "tomato",
  "planting_date": "2026-03-01",
  "soil_id": "loam",
  "row_spacing_m": 1.5,
  "emitter_spacing_m": 0.4,
  "emitter_id": "dripnet-pc-9.9",
  "lat": 31.25,
  "lon": 34.79
}

### ✓ 200: PATCH one field; everything else stays the same
PATCH {{base}}/v1/plots/{{northBlock}}
Content-Type: application/json

{ "area_m2": 1250 }

### ✓ 200: an empty PATCH changes nothing (#7)
PATCH {{base}}/v1/plots/{{northBlock}}
Content-Type: application/json

{}

### ✗ 422 VALIDATION: after merge() the plot has no name (#7)
PATCH {{base}}/v1/plots/{{northBlock}}
Content-Type: application/json

{ "name": null }

### ✗ 422 VALIDATION "body.area_m2: Input should be greater than 0"
# merge() runs the full plot through PlotCreate, so PATCH can't bypass FR-1.3
PATCH {{base}}/v1/plots/{{northBlock}}
Content-Type: application/json

{ "area_m2": -5 }

### ✗ 409 CONFLICT: rename to a name that already exists in this farm
PATCH {{base}}/v1/plots/{{northBlock}}
Content-Type: application/json

{ "name": "East block" }

### ✓ 204: delete the plot we created
DELETE {{base}}/v1/plots/{{southBlock.response.body.$.id}}

### ✗ 404 NOT_FOUND "Plot not found"
GET {{base}}/v1/plots/{{southBlock.response.body.$.id}}


############################################################
# FR-1.3 · Plot validation (all 422 VALIDATION)
# Each body is the spec example with ONE bad field.
############################################################

### ✗ area_m2 = 0 → "body.area_m2: Input should be greater than 0"
POST {{base}}/v1/plots
Content-Type: application/json

{
  "farm_id": "b7e2c0a0-3c1d-4f0a-9a11-0c5d2e6f1001",
  "name": "Bad plot",
  "area_m2": 0,
  "crop_id": "tomato",
  "planting_date": "2026-03-01",
  "soil_id": "loam",
  "row_spacing_m": 1.5,
  "emitter_spacing_m": 0.4,
  "emitter_id": "dripnet-pc-1.0",
  "lat": 31.25,
  "lon": 34.79
}

### ✗ future date → "body.planting_date: cannot be in the future" (UTC+14, #12)
POST {{base}}/v1/plots
Content-Type: application/json

{
  "farm_id": "b7e2c0a0-3c1d-4f0a-9a11-0c5d2e6f1001",
  "name": "Bad plot",
  "area_m2": 1000,
  "crop_id": "tomato",
  "planting_date": "2030-01-01",
  "soil_id": "loam",
  "row_spacing_m": 1.5,
  "emitter_spacing_m": 0.4,
  "emitter_id": "dripnet-pc-1.0",
  "lat": 31.25,
  "lon": 34.79
}

### ✗ lat out of range (and lon too: two errors joined with ";")
POST {{base}}/v1/plots
Content-Type: application/json

{
  "farm_id": "b7e2c0a0-3c1d-4f0a-9a11-0c5d2e6f1001",
  "name": "Bad plot",
  "area_m2": 1000,
  "crop_id": "tomato",
  "planting_date": "2026-03-01",
  "soil_id": "loam",
  "row_spacing_m": 1.5,
  "emitter_spacing_m": 0.4,
  "emitter_id": "dripnet-pc-1.0",
  "lat": 120,
  "lon": 200
}

### ✗ number sent as a string: strict numbers (#10)
POST {{base}}/v1/plots
Content-Type: application/json

{
  "farm_id": "b7e2c0a0-3c1d-4f0a-9a11-0c5d2e6f1001",
  "name": "Bad plot",
  "area_m2": "1000",
  "crop_id": "tomato",
  "planting_date": "2026-03-01",
  "soil_id": "loam",
  "row_spacing_m": 1.5,
  "emitter_spacing_m": 0.4,
  "emitter_id": "dripnet-pc-1.0",
  "lat": 31.25,
  "lon": 34.79
}

### ✗ unknown crop → "Unknown crop"
POST {{base}}/v1/plots
Content-Type: application/json

{
  "farm_id": "b7e2c0a0-3c1d-4f0a-9a11-0c5d2e6f1001",
  "name": "Bad plot",
  "area_m2": 1000,
  "crop_id": "banana",
  "planting_date": "2026-03-01",
  "soil_id": "loam",
  "row_spacing_m": 1.5,
  "emitter_spacing_m": 0.4,
  "emitter_id": "dripnet-pc-1.0",
  "lat": 31.25,
  "lon": 34.79
}

### ✗ a field the model doesn't know (extra="forbid")
POST {{base}}/v1/plots
Content-Type: application/json

{
  "farm_id": "b7e2c0a0-3c1d-4f0a-9a11-0c5d2e6f1001",
  "name": "Bad plot",
  "area_m2": 1000,
  "crop_id": "tomato",
  "planting_date": "2026-03-01",
  "soil_id": "loam",
  "row_spacing_m": 1.5,
  "emitter_spacing_m": 0.4,
  "emitter_id": "dripnet-pc-1.0",
  "lat": 31.25,
  "lon": 34.79,
  "color": "red"
}


############################################################
# FR-1.2 · Read-only catalogues
############################################################

### ✓ 200: crops
GET {{base}}/v1/crops

### ✓ 200: soils
GET {{base}}/v1/soils

### ✓ 200: { "id": "dripnet-pc-1.0", "name": "DripNet PC", "flow_lph": 1.0 }
GET {{base}}/v1/emitters/dripnet-pc-1.0

### ✗ 404 NOT_FOUND "Crop not found": ids are exact, Tomato ≠ tomato (#13)
GET {{base}}/v1/crops/Tomato

### ✗ 405 VALIDATION + header "Allow: GET": no write routes exist (#4)
POST {{base}}/v1/crops
Content-Type: application/json

{ "id": "mango", "name": "Mango" }

### ✗ 405: same for DELETE
DELETE {{base}}/v1/soils/sand


############################################################
# FR-1.4 · Every error is problem+json
# Check the response headers: Content-Type: application/problem+json
############################################################

### ✗ 404 NOT_FOUND "No route matches /v1/nothing-here": FastAPI's own 404, reshaped
GET {{base}}/v1/nothing-here

### 503 / 500: these need a terminal step first (see the demo guide).
#
# 503: in a terminal:   mv registry.db registry.db.bak
#      → send the request below: 503, "Database unavailable", Retry-After: 5
#      → /health still answers 200 (it doesn't need the DB)
#      → restore:        mv registry.db.bak registry.db
#
# 500: in a terminal:   sqlite3 registry.db "ALTER TABLE plots RENAME TO plots_x"
#      → send the request below: 500, "Internal server error", NO Retry-After,
#        and the full traceback appears only in the server terminal
#      → restore:        bash seed_registry.sh

### 503 or 500, depending on the step above
GET {{base}}/v1/plots
