# Only the keys below are allowed. An unknown key (including a typo) stops the
# service at startup, so a mistake in .env fails loudly instead of being ignored.

# mode=rw&uri=true is required so a missing file is an error, not a new empty database.
# A relative path is resolved from the directory the service is started in, so start
# it from services/registry-service.
DATABASE_URL=sqlite:///file:registry.db?mode=rw&uri=true
# PostgreSQL (percent-encode special characters in the password):
# DATABASE_URL=postgresql+psycopg://agropilot:<password>@localhost:5432/registry

DB_CONNECT_TIMEOUT_SECONDS=3
DB_BUSY_TIMEOUT_SECONDS=5
DB_POOL_TIMEOUT_SECONDS=5

# Plot photos in S3 (required). No credentials here: boto3 reads ~/.aws locally and
# the instance's IAM role on EC2.
AWS_S3_BUCKET=roi-agropilot-photos
AWS_REGION=us-east-1
# Optional, these are the defaults:
# S3_CONNECT_TIMEOUT_SECONDS=3
# S3_READ_TIMEOUT_SECONDS=10
# S3_MAX_ATTEMPTS=3
