# Only the keys below are allowed. An unknown key (including a typo) stops the
# service at startup, so a mistake in .env fails loudly instead of being ignored.

# registry-service base URL (required).
REGISTRY_URL=http://127.0.0.1:8000
# weather-service base URL (required).
WEATHER_URL=http://127.0.0.1:8001
# Whole registry call, in seconds (> 0).
REGISTRY_TIMEOUT_SECONDS=3
# Whole weather call, in seconds (> 0). Must be above WEATHER_REFRESH_DEADLINE_SECONDS.
WEATHER_TIMEOUT_SECONDS=6
# Daily cap on one plot's irrigation run, in minutes (1..1440).
MAX_DAILY_RUN_MINUTES=1440
# Replaces the crop's depletion fraction p for every crop (0..1). Empty is an error: leave
# the line commented out to keep each crop's own p.
# DEPLETION_FRACTION_OVERRIDE=0.5
# Weather-service's own refresh deadline, in seconds. Keep it equal to weather-service's value.
WEATHER_REFRESH_DEADLINE_SECONDS=5
# Retry-After, in seconds, of a 503 when the upstream sent none (>= 0).
RETRY_AFTER_SECONDS=5
