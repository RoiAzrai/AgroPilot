# Only the keys below are allowed. An unknown key (including a typo) stops the
# service at startup, so a mistake in .env fails loudly instead of being ignored.

PROVIDER_BASE_URL=https://api.open-meteo.com/v1/forecast
PROVIDER_API_KEY=
PROVIDER_ATTEMPT_TIMEOUT_SECONDS=1.5
PROVIDER_RETRIES=2
PROVIDER_RETRY_BACKOFF_SECONDS=0.2
REFRESH_DEADLINE_SECONDS=5
FORECAST_FRESH_SECONDS=10800
FORECAST_MAX_STALE_SECONDS=86400
FAILURE_PAUSE_SECONDS=60
RETRY_AFTER_SECONDS=5
